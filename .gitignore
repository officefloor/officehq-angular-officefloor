# Build output — the agent's committed delta is source only (BASE_CHECKLIST.md §G).
target/
*.jar
node_modules/
.run/
# Front-end build artifacts written into static/ by bin/build (vite outDir). Keep the committed
# base shell (static/index.html) and ignore generated bundles.
src/main/resources/static/assets/
# Playwright
e2e/test-results/
e2e/playwright-report/
# The harness copies cpNN specs in per checkpoint; don't commit them to the base.
e2e/specs/*
!e2e/specs/.gitkeep
