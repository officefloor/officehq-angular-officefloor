#!/usr/bin/env bash
# Start the app on $PORT: java -jar the built jar (main class net.officefloor.OfficeFloorMain). On
# boot, officeflyway_migrate migrates the empty in-memory H2 up to the current schema and WoOF
# serves the SPA (from PUBLIC/) + the .yml routes. Returns once launching (the harness polls
# /health). PINNED — do not edit. Contract: BASE_CHECKLIST.md §B, §C.
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p .run

: "${PORT:?PORT must be set by the harness}"
JAR="$(ls -t target/*.jar 2>/dev/null | head -n1 || true)"
[ -n "$JAR" ] || { echo "no jar in target/ — run bin/build first" >&2; exit 1; }

# TODO: confirm how OfficeFloorMain takes the HTTP port and the harness profile that enables the
#   /__test__ routes (OfficeFloor profile-specific config), e.g. -Dhttp.port / --http.port and
#   -Dofficefloor.profiles=harness (verify exact flags).
nohup java -jar "$JAR" --http.port="$PORT" > .run/app.log 2>&1 &
echo $! > .run/app.pid
