#!/usr/bin/env bash
# Build the whole app into ONE runnable jar. The Maven build runs the front-end (frontend-maven-
# plugin) into src/main/resources/PUBLIC, then packages the WoOF app (spring-boot repackage,
# mainClass net.officefloor.OfficeFloorMain) into target/*.jar. PINNED — do not edit.
# Contract: BASE_CHECKLIST.md §B, §C. Must succeed from a clean base-empty checkout (§A).
set -euo pipefail
cd "$(dirname "$0")/.."

# One command: the pom's frontend-maven-plugin builds the SPA into PUBLIC during the build.
exec ./mvnw -q -DskipTests package
# TODO: add the Maven wrapper (./mvnw) or switch to `mvn` if a system Maven is guaranteed.
